      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "DCGM_FI_DEV_XID_ERRORS is a gauge holding the code of the last XID error the driver reported, not a running count, so it is read as a gauge and not wrapped in increase(). Zero means no XID has been reported. Anything else is the code of the fault, it stays latched at that value, and the run that was in flight is not trustworthy.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "none"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
